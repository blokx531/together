# Copy to .env.local and fill in. Never commit real values.
#
# Supabase project URL, e.g. https://<project-ref>.supabase.co
# Local development: run `npm run db:start` and use the "API URL" it prints (http://127.0.0.1:54321).
VITE_SUPABASE_URL=
# Supabase publishable (anon) key. This key is designed to be public; Row Level Security protects data.
# NEVER put the secret/service-role key here: every VITE_* variable is shipped to the browser.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: MapLibre style URL for the travel map. Defaults to OpenFreeMap "positron" (keyless).
VITE_MAP_STYLE_URL=
